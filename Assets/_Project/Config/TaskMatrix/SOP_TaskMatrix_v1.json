  "loops": [
    {
      "id": "nextRivet",
      "style": "solid",
      "label": "下一颗",
      "from": "p6",
      "to": "p4",
      "when": "station.hasNextRivet",
      "explain": "工位内逐钉循环 T4～T6。"
    },
    {
      "id": "nextStationSameRegion",
      "style": "dashed",
      "label": "换站",
      "from": "p6",
      "to": "p2",
      "when": "region.hasNextStation",
      "explain": "同一区域换站，转 T2。"
    },
    {
      "id": "nextRegion",
      "style": "dashed",
      "label": "换站",
      "from": "p6",
      "to": "p1",
      "when": "mission.hasNextRegion",
      "explain": "其他区域，转 T1。"
    }
  ],
  "legend": [
    {
      "style": "exampleBold",
      "text": "示例单元 t(5,4)"
    },
    {
      "style": "dashed",
      "text": "条件触发的任务单元"
    },
    {
      "style": "grayText",
      "text": "灰字：该阶段待命"
    }
  ],
  "loopNote": "实线回路：工位内逐钉循环 T4～T6；虚线回路：同一区域换站转 T2，其他区域转 T1",
  "rules": {
    "phaseParallel": "同一阶段内所有 active 单元并行启动；全部完成后进入下一阶段。",
    "standby": "standby 单元不执行，显示灰字。",
    "conditional": "conditional 单元进入阶段时处于“已布防”状态，trigger 发生时激活；激活后该阶段须等待其完成。",
    "runWhen": "active 单元的 runWhen 不满足时显示为跳过（保持），不执行。",
    "conditionChecks": "conditionRefs 中的条件由执行器逐项判定，演示屏“当前执行情况说明”逐条显示 ✓ / ✗。v1 中这些条件由仿真状态直接给出，正常流程全部满足；不满足的情况只通过故障注入产生，并交给对应的条件触发单元（t(5,6)、t(5,7)）处理。"
  },
  "conditions": {
    "version": "v1 固定文字（教学示例阈值），后续版本细化",
    "items": [
      {
        "id": "C1",
        "stage": "T4 对中",
        "text": "本颗铆钉的机械臂与超声通道资源锁已分配",
        "check": "sched.resourceLockHeld"
      },
      {
        "id": "C2",
        "stage": "T5 贴合采集",
        "text": "底盘零速锁定有效，机械臂运动许可有效",
        "check": "safety.chassisLocked && safety.armPermit"
      },
      {
        "id": "C3",
        "stage": "T5 贴合采集",
        "text": "探头轴线与表面法向夹角 ≤ 2°",
        "check": "probe.normalErrorDeg <= 2"
      },
      {
        "id": "C4",
        "stage": "T5 贴合采集",
        "text": "探头中心与钉心对中偏差 ≤ 0.5 mm",
        "check": "probe.centerErrorMm <= 0.5"
      },
      {
        "id": "C5",
        "stage": "T5 贴合采集",
        "text": "接触力稳定在 8～12 N 且持续 ≥ 0.3 s",
        "check": "contact.forceN in [8,12] for 0.3 s"
      },
      {
        "id": "C6",
        "stage": "T5 贴合采集",
        "text": "耦合剂已注入，界面回波幅值 ≥ 60% 满屏高度",
        "check": "ut.interfaceEchoFsh >= 0.6"
      },
      {
        "id": "C7",
